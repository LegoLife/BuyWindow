# Copy to .env. A free key comes from https://www.tiingo.com/account/api/token
TIINGO_API_KEY=

# Email alerts: leave blank to keep them off. Gmail needs an app password, not your normal password:
# https://myaccount.google.com/apppasswords
SMTP_USER=
SMTP_PASSWORD=
# Where alerts go. Defaults to SMTP_USER.
ALERT_EMAIL=
# Only needed for a provider other than Gmail.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=StartTls

# The SEC asks apps to name a contact email when reading its filings, for the earnings release link.
# Defaults to ALERT_EMAIL, then SMTP_USER. With none of them set, the link is hidden.
# SEC_CONTACT_EMAIL=

# Optional: the port on this computer when using docker-compose.yml. Defaults to 8085.
# BUYWINDOW_PORT=8085
