@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject MarketStore Store
@inject EmailSender Email
@inject AlertSender Alerts
@inject OwnService Own

<PageTitle>BuyWindow</PageTitle>

<div class="page-heading">
    <div>
        <h1>Watchlist</h1>
        @if (_dataThrough is not null)
        {
            <p class="muted">Prices through @Display.Date(_dataThrough)</p>
        }
        <p class="muted">Last checked: @Display.Checked(Store.LastCheckedEastern)</p>
    </div>
    @if (Store.IsConfigured && _tickers.Count > 0)
    {
        <button class="button" disabled="@_refreshing" @onclick="RefreshAsync">@(_refreshing ? "Refreshing…" : "Refresh prices")</button>
    }
</div>

@if (!Store.IsConfigured)
{
    <p class="notice notice-warn" role="alert"><strong>! No Tiingo API key.</strong> Add your free key as <code>TIINGO_API_KEY</code> in the <code>.env</code> file, then restart the app.</p>
}
@if (Store.LastError is { } refreshError)
{
    <p class="notice notice-warn" role="alert"><strong>! Price refresh failed.</strong> @refreshError</p>
}
@if (Alerts.LastError is { } alertError)
{
    <p class="notice notice-warn" role="alert"><strong>! Email problem.</strong> @alertError</p>
}

<form class="search" @onsubmit="SearchAsync">
    <label for="ticker-search">Add a US stock or ETF</label>
    <div class="search-row">
        <input id="ticker-search" @bind="_query" @bind:event="oninput" placeholder="Symbol or company name, like BE or Bloom Energy" autocomplete="off" disabled="@(!Store.IsConfigured)" />
        <button class="button button-primary" type="submit" disabled="@(_searching || !Store.IsConfigured)">@(_searching ? "Searching…" : "Search")</button>
    </div>
</form>

@if (_formError is not null)
{
    <p class="notice notice-warn" role="alert">@_formError</p>
}

@if (_matches is not null)
{
    <section class="matches" aria-label="Search results">
        @if (_matches.Count == 0)
        {
            <p class="muted">No active US stocks or ETFs matched that search.</p>
        }
        <ul>
            @foreach (var match in _matches)
            {
                <li>
                    <span><strong>@match.Symbol</strong> @match.Name <span class="muted">· @match.AssetType</span></span>
                    <button class="button" disabled="@(_adding is not null)" @onclick="() => AddAsync(match)">
                        @(_adding == match.Symbol ? "Downloading prices…" : "Add this one")
                    </button>
                </li>
            }
        </ul>
    </section>
}

@if (_loading)
{
    <p class="muted">Loading…</p>
}
else if (_tickers.Count == 0)
{
    <p class="empty">Your watchlist is empty. Search above to add your first ticker.</p>
}
else
{
    <div class="watch-tools">
        <label for="watch-filter" class="visually-hidden">Find in watchlist</label>
        <input id="watch-filter" type="search" @bind="_filter" @bind:event="oninput" placeholder="Find in watchlist: symbol, name or group" autocomplete="off" />
        <button class="link-button" type="button" @onclick="() => SetAllCollapsed(true)">Collapse all</button>
        <button class="link-button" type="button" @onclick="() => SetAllCollapsed(false)">Expand all</button>
    </div>
    <datalist id="group-names">
        @foreach (var name in GroupNames)
        {
            <option value="@name"></option>
        }
    </datalist>

    var groups = VisibleGroups();
    if (groups.Count == 0)
    {
        <p class="empty">Nothing on your watchlist matches “@_filter.Trim()”.</p>
    }
    else
    {
    <div class="table-wrap">
        <table class="data watchlist">
            <thead>
                <tr>
                    <th>Ticker</th>
                    <th>Own it?</th>
                    <th>This month</th>
                    <th class="num">Score</th>
                    <th>Signal or first day?</th>
                    <th>Best day to buy</th>
                    <th><span class="visually-hidden">Group and remove</span></th>
                </tr>
            </thead>
            @foreach (var group in groups)
            {
                var key = group.Key;
                var open = Filtering || !_collapsed.Contains(key);
                var canDragGroup = key.Length > 0 && !Filtering;
                <tbody class="watch-group @DropClass(key) @(_draggingGroup == key ? "dragging" : "")"
                       @ondragenter="() => _dropTarget = key" @ondragover:preventDefault @ondrop="() => DropAsync(key)">
                    <tr class="group-row">
                        <th colspan="7" scope="rowgroup" draggable="@(canDragGroup ? "true" : "false")" data-drag-group="@(canDragGroup ? key : null)"
                            title="@(canDragGroup ? "Drag to reorder groups" : null)"
                            @ondragstart="() => { if (canDragGroup) _draggingGroup = key; }" @ondragend="EndDrag">
                            <button class="group-toggle" type="button" aria-expanded="@(open ? "true" : "false")" disabled="@Filtering" @onclick="() => Toggle(key)">
                                <span class="group-caret" aria-hidden="true">@(open ? "▾" : "▸")</span>
                                @(key.Length == 0 ? "Ungrouped" : key)
                                <span class="muted small">@group.Count()</span>
                            </button>
                        </th>
                    </tr>
                @if (open)
                {
                @foreach (var ticker in group)
                {
                    var analysis = ticker.Analysis;
                    <tr draggable="true" data-drag-ticker="@ticker.Symbol" class="@(_dragging == ticker.Symbol ? "dragging" : "")"
                        title="Drag onto a group to move it"
                        @ondragstart="() => _dragging = ticker.Symbol" @ondragend="EndDrag">
                        <td>
                            <a class="ticker-link" href="ticker/@ticker.Symbol">@ticker.Symbol</a>
                            <div class="muted small">@ticker.Name</div>
                        </td>
                        <td>
                            @if (_own.TryGetValue(ticker.Symbol, out var own))
                            {
                                <span class="status @(own.Verdict switch { OwnVerdict.OwnIt => "status-buy", OwnVerdict.Review => "status-warn", _ => "status-neutral" })">@(own.Verdict switch { OwnVerdict.OwnIt => "✓ Own it", OwnVerdict.Review => "! Review", _ => "– Not checked" })</span>
                                <div class="muted small">@string.Join(" · ", own.Failures.Select(f => $"{f.Name} {f.Reading}"))</div>
                            }
                            else
                            {
                                <span class="muted small">Checking…</span>
                            }
                        </td>
                        <td>
                            <span class="status @Display.StatusClass(analysis.Status.Kind)"><span aria-hidden="true">@Display.StatusGlyph(analysis.Status.Kind)</span> @Display.StatusLabel(analysis.Status)</span>
                            <div class="muted small">@Display.StatusDetail(analysis.Status) · @analysis.Status.TradingDaysLeft trading days left</div>
                        </td>
                        <td class="num" data-label="Score">@(analysis.Scores.Count > 0 ? analysis.Scores[^1].Total.ToString("0") : "-")</td>
                        <td>
                            <span class="verdict @Display.VerdictClass(analysis.Backtest.Verdict)"><span aria-hidden="true">@Display.VerdictGlyph(analysis.Backtest.Verdict)</span> @Display.VerdictLabel(analysis.Backtest.Verdict)</span>
                            <div class="muted small">
                                @analysis.Backtest.Months.Count months@(analysis.LowConfidence ? " · low confidence" : "")
                            </div>
                        </td>
                        <td>
                            <span class="best-day @(analysis.LowConfidence || analysis.Pattern?.BestWindow is null ? "status-neutral" : "")">@Display.BestDayLabel(analysis)</span>
                            <div class="muted small">@Display.BestDayDetail(analysis)</div>
                        </td>
                        <td class="num row-actions">
                            <input class="group-input" list="group-names" value="@ticker.Group" placeholder="Group" aria-label="Group for @ticker.Symbol"
                                   @onchange="e => SetGroupAsync(ticker.Symbol, e.Value as string)" />
                            <button class="link-button" @onclick="() => RemoveAsync(ticker.Symbol)" aria-label="Remove @ticker.Symbol">Remove</button>
                        </td>
                    </tr>
                }
                }
                </tbody>
            }
        </table>
    </div>
    }
}

<p class="email-status muted small">
    @if (Email.IsConfigured)
    {
        <span>Email alerts go to @Email.Recipient.</span>
        <button class="link-button" disabled="@_testing" @onclick="SendTestAsync">@(_testing ? "Sending…" : "Send a test email")</button>
        @if (_testResult is not null)
        {
            <span> @_testResult</span>
        }
    }
    else
    {
        <span>Email alerts are off. Add <code>SMTP_USER</code> and <code>SMTP_PASSWORD</code> to the <code>.env</code> file to turn them on.</span>
    }
</p>

@code {
    private IReadOnlyList<WatchedTicker> _tickers = [];
    private readonly Dictionary<string, OwnResult> _own = new(StringComparer.OrdinalIgnoreCase);
    private bool _checkingOwn;
    private IReadOnlyList<TickerMatch>? _matches;
    private DateOnly? _dataThrough;
    private string _query = "";
    private string? _formError;
    private string? _adding;
    private string? _testResult;
    private bool _loading = true, _searching, _refreshing, _testing;
    private string _filter = "";
    private string? _dragging, _draggingGroup, _dropTarget;
    private IReadOnlyList<string> _groupOrder = [];

    private void EndDrag() => (_dragging, _draggingGroup, _dropTarget) = (null, null, null);

    private string DropClass(string key)
    {
        if (_dropTarget != key) return "";
        if (_dragging is not null) return "drop-target";
        return _draggingGroup is not null && _draggingGroup != key ? "drop-before" : "";
    }

    // Saved order first, then any group not placed yet by name. Ungrouped is always last.
    private int GroupRank(string key)
    {
        if (key.Length == 0) return int.MaxValue;
        var i = _groupOrder.ToList().FindIndex(n => string.Equals(n, key, StringComparison.OrdinalIgnoreCase));
        return i < 0 ? int.MaxValue - 1 : i;
    }

    // A dragged group lands just above the group it's dropped on, or at the end when dropped on Ungrouped.
    private async Task MoveGroupAsync(string moving, string target)
    {
        if (string.Equals(moving, target, StringComparison.OrdinalIgnoreCase)) return;
        var names = VisibleGroups().Select(g => g.Key).Where(k => k.Length > 0).ToList();
        names.RemoveAll(n => string.Equals(n, moving, StringComparison.OrdinalIgnoreCase));
        var at = names.FindIndex(n => string.Equals(n, target, StringComparison.OrdinalIgnoreCase));
        names.Insert(at < 0 ? names.Count : at, moving);
        await Store.SaveGroupOrderAsync(names);
    }

    // Dropping on the group the ticker is already in does nothing.
    private async Task DropAsync(string group)
    {
        var symbol = _dragging;
        var movingGroup = _draggingGroup;
        EndDrag();
        if (movingGroup is not null)
        {
            await MoveGroupAsync(movingGroup, group);
            return;
        }
        if (symbol is null) return;
        var current = _tickers.FirstOrDefault(t => t.Symbol == symbol)?.Group ?? "";
        if (string.Equals(current, group, StringComparison.OrdinalIgnoreCase)) return;
        await Store.SetGroupAsync(symbol, group);
    }
    private readonly HashSet<string> _collapsed = new(StringComparer.OrdinalIgnoreCase);

    private bool Filtering => !string.IsNullOrWhiteSpace(_filter);

    private IEnumerable<string> GroupNames =>
        _tickers.Select(t => t.Group).OfType<string>().Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase);

    // Named groups alphabetically, ungrouped last. A filter matches symbol, name or group and opens every group with a match.
    private List<IGrouping<string, WatchedTicker>> VisibleGroups()
    {
        var term = _filter.Trim();
        return _tickers
            .Where(t => term.Length == 0
                || t.Symbol.Contains(term, StringComparison.OrdinalIgnoreCase)
                || t.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                || (t.Group?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false))
            .GroupBy(t => t.Group ?? "", StringComparer.OrdinalIgnoreCase)
            .OrderBy(g => GroupRank(g.Key))
            .ThenBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private void Toggle(string group)
    {
        if (!_collapsed.Remove(group)) _collapsed.Add(group);
    }

    private void SetAllCollapsed(bool collapsed)
    {
        _collapsed.Clear();
        if (collapsed) _collapsed.UnionWith(_tickers.Select(t => t.Group ?? ""));
    }

    private Task SetGroupAsync(string symbol, string? group) => Store.SetGroupAsync(symbol, group);

    protected override async Task OnInitializedAsync()
    {
        Store.Changed += OnStoreChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _tickers = await Store.LoadWatchlistAsync();
        _groupOrder = await Store.LoadGroupOrderAsync();
        _dataThrough = _tickers.Max(t => t.Analysis.HistoryEnd);
        _loading = false;
        if (!_checkingOwn) _ = CheckOwnAsync();
    }

    // One ticker at a time, after the table shows: Finviz is read one page at a time anyway.
    private async Task CheckOwnAsync()
    {
        _checkingOwn = true;
        try
        {
            foreach (var ticker in _tickers.ToList())
            {
                var result = await Own.ForAsync(ticker);
                await InvokeAsync(() => { _own[ticker.Symbol] = result; StateHasChanged(); });
            }
        }
        catch (ObjectDisposedException)
        {
            // The page was closed before every ticker was checked.
        }
        finally
        {
            _checkingOwn = false;
        }
    }

    private void OnStoreChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private async Task SearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_query)) return;

        _searching = true;
        _formError = null;
        try
        {
            _matches = (await Store.SearchAsync(_query.Trim())).Take(8).ToList();
        }
        catch (MarketDataException ex)
        {
            _matches = null;
            _formError = ex.Message;
        }
        _searching = false;
    }

    private async Task AddAsync(TickerMatch match)
    {
        _adding = match.Symbol;
        _formError = null;
        try
        {
            await Store.AddAsync(match);
            _matches = null;
            _query = "";
        }
        catch (MarketDataException ex)
        {
            _formError = ex.Message;
        }
        _adding = null;
    }

    private Task RemoveAsync(string symbol) => Store.RemoveAsync(symbol);

    private async Task RefreshAsync()
    {
        _refreshing = true;
        await Store.RefreshDueAsync(force: true);
        await Store.RefreshQuotesAsync(force: true);
        _refreshing = false;
    }

    private async Task SendTestAsync()
    {
        _testing = true;
        _testResult = await Alerts.SendTestAsync();
        _testing = false;
    }

    public void Dispose() => Store.Changed -= OnStoreChanged;
}
