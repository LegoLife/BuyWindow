@page "/ticker/{Symbol}"
@rendermode InteractiveServer
@implements IDisposable
@inject MarketStore Store
@inject SecClient Sec
@inject FinvizClient Finviz

<PageTitle>@(Symbol.ToUpperInvariant()) · BuyWindow</PageTitle>

@if (_loading)
{
    <p class="muted">Loading…</p>
}
else if (_ticker is null)
{
    <h1>@Symbol.ToUpperInvariant()</h1>
    <p>That ticker isn't on your watchlist. <a href="">Back to the watchlist</a></p>
}
else
{
    var analysis = _ticker.Analysis;
    var backtest = analysis.Backtest;
    var latest = analysis.Scores.Count > 0 ? analysis.Scores[^1] : null;

    <p class="crumb"><a href="">← Watchlist</a></p>
    <h1>@_ticker.Symbol <span class="muted heading-name">@_ticker.Name</span></h1>
    @if (_move is { } move)
    {
        <div class="price-now">
            <span class="price-value">@move.Price.ToString("0.00")</span>
            <span class="price-change @(move.IsUp ? "price-up" : move.IsDown ? "price-down" : "")"><span aria-hidden="true">@(move.IsUp ? "▲" : move.IsDown ? "▼" : "●")</span> @move.Change.ToString("+0.00;-0.00;0.00") (@Display.Percent(move.ChangePercent))</span>
            <span class="price-note muted small">@_priceNote</span>
        </div>
    }
    @if (Sec.IsConfigured)
    {
        <p class="earnings small">
            @if (_earnings is { } release)
            {
                @if (release.CallUrl is { } call)
                {
                    <a href="@call" target="_blank" rel="noopener noreferrer">Earnings call webcast</a>
                    <span class="muted"> (@Display.Host(call), where the release says the call is) · </span>
                }
                <a href="@release.Url" target="_blank" rel="noopener noreferrer">Earnings release, @Display.Date(release.Filed)</a>
                @if (release.CallUrl is null)
                {
                    <span class="muted"> · The release doesn't give a webcast link, so check the company's investor site.</span>
                }
            }
            else if (_earningsLoaded)
            {
                <span class="muted">No earnings release found at the SEC. ETFs and most foreign companies don't file them there.</span>
            }
            else
            {
                <span class="muted">Looking up the latest earnings release…</span>
            }
        </p>
    }
    @if (Sec.IsConfigured)
    {
        <section class="lynch" aria-label="Peter Lynch checks">
            @if (_financials is { } financials && _move is { } priced)
            {
                var lynch = LynchScore.For(financials, priced.Price);
                <h2>Peter Lynch checks: @lynch.Passed of @lynch.Checked pass</h2>
                <div class="table-wrap">
                    <table class="data">
                        <thead>
                            <tr><th>Rule</th><th>Needs</th><th>Reading</th><th>Result</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var check in lynch.Checks)
                            {
                                <tr>
                                    <td>@check.Name</td>
                                    <td>@check.Rule</td>
                                    <td class="@(check.Passes is null ? "muted" : "")">@check.Reading</td>
                                    <td class="@(check.Passes switch { true => "check-pass", false => "check-fail", _ => "muted" })">
                                        <span aria-hidden="true">@(check.Passes switch { true => "✓", false => "✗", _ => "–" })</span>
                                        @(check.Passes switch { true => "Pass", false => "Fail", _ => "Not checked" })
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="muted small">
                    Earnings through @Display.Date(lynch.EarningsThrough) and balance sheet on @Display.Date(lynch.BalanceSheetAt), from SEC filings, at a price of @priced.Price.ToString("0.00").
                    Growth compares the last 12 months' earnings per share with the 12 months before. For information only: this doesn't affect the score or the buy rule.
                </p>
            }
            else if (_financialsLoaded)
            {
                <p class="muted small">Peter Lynch checks: no company financials found at the SEC. ETFs and most foreign companies don't file them there.</p>
            }
            else
            {
                <p class="muted small">Looking up the company's financials for the Peter Lynch checks…</p>
            }
        </section>
    }
    <section class="finviz" aria-label="Finviz">
        <div class="chart-heading">
            <h2>Finviz</h2>
            <a href="@FinvizSnapshot.QuoteUrl(_ticker.Symbol)" target="_blank" rel="noopener noreferrer">View @_ticker.Symbol on Finviz ↗</a>
        </div>
        @if (_finviz?.Snapshot is { } finviz)
        {
            <div class="stats">
                @foreach (var label in KeyFinvizFields)
                {
                    var field = finviz.Field(label);
                    <div class="stat">
                        <div class="stat-value @ToneClass(field?.Tone)">@(field?.Value ?? "-")</div>
                        <div class="muted small">@label</div>
                    </div>
                }
            </div>
            <details>
                <summary>All @finviz.Columns.Sum(c => c.Count) readings</summary>
                <div class="finviz-grid">
                    @foreach (var column in finviz.Columns)
                    {
                        <table class="data finviz-table">
                            <tbody>
                                @foreach (var field in column)
                                {
                                    <tr><th scope="row">@field.Label</th><td class="num @ToneClass(field.Tone)">@field.Value</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </details>
            <h3>Latest headlines</h3>
            @if (finviz.Headlines.Count == 0)
            {
                <p class="muted small">Finviz lists no news for this ticker.</p>
            }
            else
            {
                <ul class="headlines">
                    @foreach (var headline in finviz.Headlines)
                    {
                        <li>
                            <a href="@headline.Url" target="_blank" rel="noopener noreferrer nofollow">@headline.Title</a>
                            <div class="muted small">@headline.Source · @Display.Checked(headline.At)</div>
                        </li>
                    }
                </ul>
            }
            <p class="muted small">From Finviz, fetched @Display.Checked(_finviz.FetchedEastern). Kept for an hour. For information only: this doesn't affect the score or the buy rule.</p>
        }
        else if (_finviz is { } failed)
        {
            <p class="muted small">Couldn't read Finviz: @failed.Problem</p>
        }
        else
        {
            <p class="muted small">Reading Finviz…</p>
        }
    </section>
    <p class="muted">
        Using @Display.Date(analysis.HistoryStart) to @Display.Date(analysis.HistoryEnd)
        @if (analysis.LowConfidence)
        {
            <span class="chip">Low confidence: under 5 years of data</span>
        }
    </p>

    @if (analysis.Bars.Count > 0)
    {
        <section aria-label="Moving averages">
            <div class="chart-heading">
                <h2>Price and moving averages @(_averagePoints.Count > 0 ? ChartPeriod() : "")</h2>
                @if (latest is not null)
                {
                    <label class="range-picker">
                        <span class="visually-hidden">Chart range</span>
                        <select @bind="_rangeMonths" @bind:after="BuildScoreChart">
                            <option value="1">1 month</option>
                            <option value="3">3 months</option>
                            <option value="6">6 months</option>
                            <option value="12">1 year</option>
                            <option value="60">5 years</option>
                            <option value="@MaxRange">Max</option>
                        </select>
                    </label>
                }
            </div>
            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr><th>Average</th><th class="num">Value</th><th class="num">Close compared with it</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var average in _averages)
                        {
                            <tr>
                                <td>@(average.Period is null ? $"YTD (since {Display.Date(YearStart(analysis.Bars))})" : average.Name)</td>
                                @if (average.Latest is { } value)
                                {
                                    <td class="num">@value.ToString("0.00")</td>
                                    <td class="num">@Display.Percent(MovingAverages.PercentFrom(analysis.Bars[^1].Close, value))</td>
                                }
                                else
                                {
                                    <td class="num muted" colspan="2">Needs @average.Period trading days</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_averagePoints.Count > 0)
            {
                <div class="chart-gap"></div>
                <LineChart Points="_averagePoints" Lines="_averageLines" Label="@($"{_ticker.Symbol} closing price with its 5, 20, 50, 100 and 200-day and year-to-date moving averages")" Name="Price" />
            }
            <p class="muted small">Closes on @Display.Date(analysis.Bars[^1].Date). For information only: these don't affect the score or the buy rule. The range applies to both charts on this page. Hover for the values on any day.</p>
        </section>
    }

    <section class="verdict-panel @Display.VerdictClass(backtest.Verdict)" aria-label="Signal or first trading day?">
        <h2><span aria-hidden="true">@Display.VerdictGlyph(backtest.Verdict)</span> @Display.VerdictLabel(backtest.Verdict)</h2>
        <p>@Display.VerdictSentence(backtest)</p>
        @if (backtest.Months.Count > 1)
        {
            <p class="muted small">@Display.VerdictDetail(backtest)</p>
        }
    </section>

    <section>
        <h2>This month</h2>
        <p>
            <span class="status @Display.StatusClass(analysis.Status.Kind)"><span aria-hidden="true">@Display.StatusGlyph(analysis.Status.Kind)</span> @Display.StatusLabel(analysis.Status)</span>
            <span class="muted"> · @Display.StatusDetail(analysis.Status) · @analysis.Status.TradingDaysLeft trading days left</span>
        </p>

        @if (latest is not null)
        {
            <div class="score-summary">
                <div class="stat">
                    <div class="stat-value">@latest.Total.ToString("0")</div>
                    <div class="muted small">Score on @Display.Short(latest.Date), out of 100. A buy triggers at @BuyRule.Threshold.ToString("0").</div>
                </div>
            </div>

            <div class="table-wrap">
                <table class="data">
                    <thead>
                        <tr><th>Indicator</th><th>Reading</th><th>What it asks</th><th>Points</th></tr>
                    </thead>
                    <tbody>
                        <ScoreRow Name="RSI (14-day)" Reading="@latest.Rsi.ToString("0.0")" Question="Has it been sold off recently?" Points="latest.RsiPoints" />
                        <ScoreRow Name="Bollinger Bands" Reading="@($"{latest.PercentB * 100:0}% of band")" Question="Is it low compared with its recent range?" Points="latest.BollingerPoints" />
                        <ScoreRow Name="MACD" Reading="@latest.MacdHistogram.ToString("+0.00;-0.00;0.00")" Question="Is the downward momentum fading?" Points="latest.MacdPoints" />
                        <ScoreRow Name="Volume" Reading="@($"{latest.VolumeRatio:0.0}x average")" Question="Is heavy selling behind the move?" Points="latest.VolumePoints" />
                        <ScoreRow Name="Market trend" Reading="@(latest.MarketAboveAverage ? "SPY above 200-day" : "SPY below 200-day")" Question="Is the overall market healthy?" Points="latest.MarketPoints" />
                    </tbody>
                </table>
            </div>

            <h3>Score and price @ChartPeriod()</h3>
            <LineChart Points="_scorePoints" Label="@($"{_ticker.Symbol} daily buy score and closing price")" Min="0" Max="100" Reference="BuyRule.Threshold" Name="Score" SecondName="Price" />
            <p class="muted small">Price is drawn on the same 0 to 100 scale: 0 is its lowest close in this period (@_priceLow.ToString("0.00")) and 100 is its highest (@_priceHigh.ToString("0.00")). Hover for the actual price. The flat line at @BuyRule.Threshold.ToString("0") is the buy trigger and applies only to the score. Dots mark the days the rule bought, at that day's open, which can differ from the close shown here. The range is picked at the top of the page.</p>

            @if (_reviews.Count > 0)
            {
                <h3>Purchases in this period</h3>
                <div class="table-wrap">
                    <table class="data">
                        <thead>
                            <tr><th>Bought</th><th>Why</th><th class="num">Score the night before</th><th class="num">Price paid</th><th class="num">Month's low</th><th class="num">@BuyReviews.LaterTradingDays trading days later</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var review in _reviews)
                            {
                                <tr>
                                    <td>@Display.Date(review.BuyDate)</td>
                                    <td>@(review.Reason == BuyReason.Signal ? "Signal" : "Deadline")</td>
                                    <td class="num">@(review.ScoreBefore?.ToString("0") ?? "-")</td>
                                    <td class="num">@review.PricePaid.ToString("0.00")</td>
                                    <td class="num">@review.MonthLow.ToString("0.00")@(review.MonthFinished ? "" : " so far")</td>
                                    <td class="num">@(review.PriceLater is { } later ? $"{later:0.00} ({Display.Percent(review.ChangeLaterPercent!.Value)})" : "Not yet")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="muted small">Prices are adjusted for later splits and dividends, so they can differ from what was actually quoted that day.</p>
            }
        }
    </section>

    <section>
        <h2>Backtest</h2>
        @if (backtest.Months.Count == 0)
        {
            <p class="muted">No finished months to test yet.</p>
        }
        else
        {
            <div class="stats">
                <div class="stat">
                    <div class="stat-value">@backtest.SignalMonths of @backtest.Months.Count</div>
                    <div class="muted small">Months the signal triggered. The rest bought at the deadline.</div>
                </div>
                <div class="stat">
                    <div class="stat-value">@Display.Percent(backtest.MeanSignalAboveLowPercent)</div>
                    <div class="muted small">Signal's purchase above the month's lowest price</div>
                </div>
                <div class="stat">
                    <div class="stat-value">@Display.Percent(backtest.MeanBaselineAboveLowPercent)</div>
                    <div class="muted small">First trading day's price above the month's lowest</div>
                </div>
            </div>

            <details>
                <summary>Month-by-month results</summary>
                <div class="table-wrap">
                    <table class="data">
                        <thead>
                            <tr><th>Bought</th><th>Why</th><th class="num">Price paid</th><th class="num">First day</th><th class="num">Month's low</th><th class="num">Saving vs first day</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var month in backtest.Months.Reverse())
                            {
                                <tr>
                                    <td>@Display.Date(month.BuyDate)</td>
                                    <td>@(month.Reason == BuyReason.Signal ? "Signal" : "Deadline")</td>
                                    <td class="num">@month.BuyPrice.ToString("0.00")</td>
                                    <td class="num">@month.FirstDayOpen.ToString("0.00")</td>
                                    <td class="num">@month.MonthLow.ToString("0.00")</td>
                                    <td class="num">@Display.Percent(month.EdgePercent)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }

        @if (_trend is { } trend)
        {
            <h3>Test: adding this ticker's 200-day average to the score</h3>
            <p><strong>@Display.TrendSentence(trend)</strong></p>
            @if (trend.Difference.Count > 0)
            {
                <div class="table-wrap">
                    <table class="data">
                        <thead>
                            <tr><th>Score</th><th class="num">Months the signal triggered</th><th class="num">Saving vs first day</th></tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Current</td>
                                <td class="num">@trend.Current.SignalMonths of @trend.Current.Months.Count</td>
                                <td class="num">@Display.Percent(trend.Current.Edge.Mean)</td>
                            </tr>
                            <tr>
                                <td>With 200-day average</td>
                                <td class="num">@trend.WithTrend.SignalMonths of @trend.WithTrend.Months.Count</td>
                                <td class="num">@Display.Percent(trend.WithTrend.Edge.Mean)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <p class="muted small">@Display.TrendDetail(trend) Both use the same months, which can be fewer than the backtest above. Being at or above the average earns full points, and six indicators share the 100 points, with the trigger still at @BuyRule.Threshold.ToString("0"). This is only a test: the live score and alerts don't use it.</p>
            }
        }
    </section>

    <section>
        <h2>Day-of-month pattern</h2>
        @if (analysis.LowConfidence || analysis.Pattern is not { } pattern)
        {
            @if (analysis.Pattern?.BestDay is not null)
            {
                <p><strong>Best day so far: @Display.BestDayLabel(analysis).ToLowerInvariant()</strong>. @Display.BestDayDetail(analysis).</p>
            }
            <p class="muted">The full pattern is hidden: there's under 5 years of data, so it would mostly be noise.</p>
        }
        else
        {
            @if (pattern.BestWindow is { } window)
            {
                <p><strong>Cheapest window: trading days @window.FirstTradingDay-@window.LastTradingDay</strong>, about the @Display.Ordinal(window.ApproxFirstDayOfMonth) to the @Display.Ordinal(window.ApproxLastDayOfMonth), typically @Display.Percent(window.Range.Mean) from the month's average.</p>
            }
            else
            {
                <p><strong>No reliable pattern.</strong> No part of the month stands out from the noise across @pattern.Months months.</p>
            }
            <LineChart Points="_patternPoints" Label="@($"{_ticker.Symbol} typical price by trading day of the month")" Suffix="%" Reference="0" />
            <p class="muted small">Blue line: typical distance from the month's average price, which is the flat line at 0%. Shaded: 95% range. Day labels are approximate dates.</p>

            <details>
                <summary>Pattern as a table</summary>
                <div class="table-wrap">
                    <table class="data">
                        <thead><tr><th class="num">Trading day</th><th class="num">About the</th><th class="num">Typical</th><th class="num">95% range</th><th class="num">Months</th></tr></thead>
                        <tbody>
                            @foreach (var day in pattern.Days)
                            {
                                <tr>
                                    <td class="num">@day.TradingDay</td>
                                    <td class="num">@Display.Ordinal(day.ApproxDayOfMonth)</td>
                                    <td class="num">@Display.Percent(day.Range.Mean)</td>
                                    <td class="num">@Display.Percent(day.Range.Low) to @Display.Percent(day.Range.High)</td>
                                    <td class="num">@day.Range.Count</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </details>
        }
    </section>
}

@code {
    [Parameter] public required string Symbol { get; set; }

    private WatchedTicker? _ticker;
    private IReadOnlyList<ChartPoint> _scorePoints = [];
    private IReadOnlyList<ChartPoint> _patternPoints = [];
    private IReadOnlyList<ChartPoint> _averagePoints = [];
    private IReadOnlyList<ChartLine> _averageLines = [];
    private IReadOnlyList<MovingAverage> _averages = [];
    private TrendComparisonResult? _trend;
    private PriceMove? _move;
    private EarningsRelease? _earnings;
    private bool _earningsLoaded;
    private Financials? _financials;
    private bool _financialsLoaded;
    private FinvizResult? _finviz;

    // Shown as tiles above Finviz's full table.
    private static readonly string[] KeyFinvizFields = ["P/E", "Forward P/E", "Short Float", "Short Interest", "Short Ratio"];

    private static string ToneClass(FinvizTone? tone) => tone switch
    {
        FinvizTone.Positive => "check-pass",
        FinvizTone.Negative => "check-fail",
        _ => "",
    };
    private string _priceNote = "";
    private IReadOnlyList<BuyReview> _reviews = [];
    private double _priceLow, _priceHigh;
    private const int MaxRange = 0;

    // Months back, with how the chart's heading names that span.
    private static readonly Dictionary<int, string> ChartRanges = new()
    {
        [1] = "month",
        [3] = "3 months",
        [6] = "6 months",
        [12] = "year",
        [60] = "5 years",
    };

    private int _rangeMonths = 12;
    private bool _rangeCovered;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _ticker = await Store.LoadAsync(Symbol.ToUpperInvariant());
        _loading = false;
        if (_ticker is null) return;

        var analysis = _ticker.Analysis;
        ReadPrice();
        _ = LoadEarningsAsync(_ticker.Symbol);
        _ = LoadFinancialsAsync(_ticker.Symbol);
        _ = LoadFinvizAsync(_ticker.Symbol);
        _averages = MovingAverages.For(analysis.Bars);
        _trend = await Task.Run(() => TrendComparison.Run(analysis.Bars, analysis.Scores));

        BuildScoreChart();

        _patternPoints = (_ticker.Analysis.Pattern?.Days ?? [])
            .Select(d => new ChartPoint(
                Display.Ordinal(d.ApproxDayOfMonth),
                d.Range.Mean,
                $"Trading day {d.TradingDay}, about the {Display.Ordinal(d.ApproxDayOfMonth)}: {Display.Percent(d.Range.Mean)}",
                double.IsFinite(d.Range.Low) ? d.Range.Low : null,
                double.IsFinite(d.Range.High) ? d.Range.High : null))
            .ToList();
    }

    private string ChartPeriod() =>
        _rangeMonths == MaxRange ? $"since {Display.Date(_ticker!.Analysis.Scores[0].Date)}"
        : _rangeCovered ? $"over the last {ChartRanges[_rangeMonths]}"
        : $"over the last {_scorePoints.Count} trading days";

    private void BuildScoreChart()
    {
        var scores = _ticker!.Analysis.Scores;
        var start = _rangeMonths == MaxRange || scores.Count == 0 ? DateOnly.MinValue : scores[^1].Date.AddMonths(-_rangeMonths);
        var recent = scores.Where(s => s.Date >= start).ToList();
        _rangeCovered = scores.Count > 0 && scores[0].Date <= start;
        var labelFormat = _rangeMonths is MaxRange or > 12 ? "MMM yyyy" : "MMM d";
        var bars = _ticker.Analysis.Bars.ToDictionary(b => b.Date);
        var reviews = recent.Count > 0 ? BuyReviews.Since(_ticker.Analysis, recent[0].Date) : [];
        var bought = reviews.ToDictionary(r => r.BuyDate);
        _reviews = reviews.Reverse().ToList();

        string Tip(DayScore s) =>
            $"{Display.Date(s.Date)}: score {s.Total:0}, closed at {bars[s.Date].Close:0.00}"
            + (bought.TryGetValue(s.Date, out var review) ? $", bought at {review.PricePaid:0.00}" : "");

        _priceLow = recent.Select(s => bars[s.Date].Close).DefaultIfEmpty().Min();
        _priceHigh = recent.Select(s => bars[s.Date].Close).DefaultIfEmpty().Max();
        var priceRange = _priceHigh - _priceLow;

        _scorePoints = recent
            .Select(s => new ChartPoint(
                s.Date.ToString(labelFormat),
                s.Total,
                Tip(s),
                Marked: bought.ContainsKey(s.Date),
                Second: priceRange > 0 ? (bars[s.Date].Close - _priceLow) / priceRange * 100 : 50))
            .ToList();

        BuildAverageChart(recent, labelFormat);
    }

    // Covers the same days as the score chart, so the two can be read together.
    private void BuildAverageChart(IReadOnlyList<DayScore> days, string labelFormat)
    {
        var allBars = _ticker!.Analysis.Bars;
        var indexes = allBars.Select((bar, i) => (bar.Date, i)).ToDictionary(x => x.Date, x => x.i);
        var shown = days.Select(d => indexes[d.Date]).ToList();

        string Tip(int i)
        {
            var readings = _averages.Where(a => a.Values[i] is not null).Select(a => $"{a.Name} {a.Values[i]:0.00}");
            return string.Join(", ", new[] { $"{Display.Date(allBars[i].Date)}: closed at {allBars[i].Close:0.00}" }.Concat(readings));
        }

        _averagePoints = shown
            .Select(i => new ChartPoint(allBars[i].Date.ToString(labelFormat), allBars[i].Close, Tip(i)))
            .ToList();

        _averageLines = _averages
            .Select((a, slot) => new ChartLine(a.Name, shown.Select(i => a.Values[i]).ToList(), slot + 2))
            .ToList();
    }

    // Fetched after the page shows, so a slow SEC response never holds it up.
    private async Task LoadEarningsAsync(string symbol)
    {
        var release = await Sec.LatestEarningsAsync(symbol);
        try
        {
            await InvokeAsync(() =>
            {
                if (_ticker?.Symbol != symbol) return;
                (_earnings, _earningsLoaded) = (release, true);
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // The page was closed, or this was the prerender, before the SEC answered.
        }
    }

    private async Task LoadFinancialsAsync(string symbol)
    {
        var financials = await Sec.FinancialsAsync(symbol);
        try
        {
            await InvokeAsync(() =>
            {
                if (_ticker?.Symbol != symbol) return;
                (_financials, _financialsLoaded) = (financials, true);
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // The page was closed, or this was the prerender, before the SEC answered.
        }
    }

    private async Task LoadFinvizAsync(string symbol)
    {
        var finviz = await Finviz.SnapshotAsync(symbol);
        try
        {
            await InvokeAsync(() =>
            {
                if (_ticker?.Symbol != symbol) return;
                _finviz = finviz;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException)
        {
            // The page was closed, or this was the prerender, before Finviz answered.
        }
    }

    protected override void OnInitialized() => Store.Changed += OnStoreChanged;

    public void Dispose() => Store.Changed -= OnStoreChanged;

    // Only the price follows the 15-minute checks; the rest of the page uses daily closes.
    private void OnStoreChanged() => _ = InvokeAsync(() =>
    {
        if (_ticker is null) return;
        ReadPrice();
        StateHasChanged();
    });

    // A live price from a newer day than the last close wins. Otherwise the last close is the latest price.
    private void ReadPrice()
    {
        var bars = _ticker!.Analysis.Bars;
        var quote = Store.QuoteFor(_ticker.Symbol);
        var quoteAt = quote is null ? (DateTime?)null : MarketStore.ToEastern(quote.At);

        if (quote is { PreviousClose: { } previous } && bars.Count > 0 && DateOnly.FromDateTime(quoteAt!.Value) > bars[^1].Date)
        {
            _move = new PriceMove(quote.Price, previous);
            _priceNote = $"Price at {quoteAt.Value.ToString("h:mm tt 'ET' MMM d", System.Globalization.CultureInfo.InvariantCulture)}, checked every 15 minutes while the market is open. Compared with the previous close of {previous:0.00}.";
        }
        else if (bars.Count >= 2)
        {
            _move = new PriceMove(bars[^1].Close, bars[^2].Close);
            _priceNote = $"Close on {Display.Date(bars[^1].Date)}, compared with the close before. Live prices show while the market is open.";
        }
        else
        {
            _move = null;
        }
    }

    private static DateOnly YearStart(IReadOnlyList<PriceBar> bars) =>
        bars.First(b => b.Date.Year == bars[^1].Date.Year).Date;
}
